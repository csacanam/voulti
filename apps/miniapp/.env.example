# Voulti Mini App — environment variables

# Privy (same app ID as merchant, but config is wallet-only here)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# Shared backend API
NEXT_PUBLIC_API_BASE_URL=https://api.voulti.com

# Public checkout URL (where payment links redirect)
NEXT_PUBLIC_CHECKOUT_URL=https://voulti.com
